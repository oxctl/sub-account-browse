{
  "config": {
    "title_suffix": "$TITLE_SUFFIX",
    "lti_registration_id": "view-subaccounts",
    "lti_account_id": "self",
    "lti_tool_url": "https://localhost:3000"
  },
  "ltiKey": {
    "tool_configuration": {
      "settings": {
        "public_jwk": {},
        "title": "View Sub-account$TITLE_SUFFIX",
        "description": "A read only view of the sub-accounts.",
        "target_link_uri": "$LTI_TOOL_URL",
        "oidc_initiation_url": "$LTI_SERVER_URL/lti/login_initiation/",
        "public_jwk_url": "$LTI_SERVER_URL/.well-known/jwks.json",
        "scopes": [],
        "extensions": [
          {
            "platform": "canvas.instructure.com",
            "settings": {
              "placements": [
                {
                  "placement": "account_navigation",
                  "message_type": "LtiResourceLinkRequest"
                }
              ]
            },
            "privacy_level": "public"
          }
        ],
        "custom_fields": {
          "canvas_account_id": "$Canvas.account.id",
          "canvas_account_name": "$Canvas.account.name",
          "canvas_api_base_url": "$Canvas.api.baseUrl",
          "canvas_user_prefers_high_contrast": "$Canvas.user.prefersHighContrast",
          "com_instructure_brand_config_json_url": "$com.instructure.brandConfigJSON.url"
        }
      }
    },
    "developer_key": {
      "name": "View Sub-account$TITLE_SUFFIX",
      "redirect_uris": "$LTI_SERVER_URL/lti/login",
      "scopes": []
    }
  },
  "apiKey" : {
    "developer_key": {
      "name": "View Sub-account$TITLE_SUFFIX",
