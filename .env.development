# Don't open a browser (as it needs to be an LTI launch)
BROWSER=none

# We need https in development
HTTPS=true
# These are the default locations that mkcert will use.
SSL_CRT_FILE=localhost.pem
SSL_KEY_FILE=localhost-key.pem

# The development proxy URL
#REACT_APP_PROXY_URL=https://localhost:18443

# Sentry setup
# The DSN, if set then errors/performance data will be sent to sentry
# REACT_APP_SENTRY_DSN=https://....
# REACT_APP_SENTRY_ENVIRONMENT=local
